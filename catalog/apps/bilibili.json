{
  "schema_version": 1,
  "app": {
    "id": "bilibili",
    "name": "哔哩哔哩",
    "critical_flows": ["登录", "视频播放", "弹幕", "评论", "搜索", "直播"]
  },
  "rules": [
    {
      "id": "bilibili.splash.v2",
      "section": "Script",
      "match": "^https?:\\/\\/app\\.bilibili\\.com\\/x\\/v2\\/splash\\/(?:show|list)(?:\\?|$)",
      "action": "http-response",
      "script_name": "NoAd_BiliBili_开屏广告清理",
      "script_path": "https://raw.githubusercontent.com/cgbzhangyu/NoAd/refs/heads/main/runtime/bilibili-splash.js",
      "requires_body": true,
      "max_size": 1048576,
      "purpose": "清空 v2 开屏广告列表与客户端缓存保留列表",
      "risk": "medium",
      "source_status": "supported",
      "device_status": "unverified",
      "mitm_hosts": ["app.bilibili.com"],
      "match_examples": [
        "https://app.bilibili.com/x/v2/splash/show?access_key=REDACTED",
        "https://app.bilibili.com/x/v2/splash/list"
      ],
      "evidence": [
        {
          "project": "blackmatrix7/ios_rule_script",
          "url": "https://github.com/blackmatrix7/ios_rule_script/blob/master/script/startup/startup.sgmodule",
          "license": "GPL-2.0-only",
          "usage": "derived",
          "notes": "Only the endpoint pattern is retained; NoAd uses an independently implemented, repository-owned response filter."
        }
      ]
    }
  ]
}

