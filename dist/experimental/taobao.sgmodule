# WARNING: 本模块需要 HTTPS 解密，默认不得启用。
# 仅在阅读风险说明并准备完成真机回归后安装。

[URL Rewrite]
# taobao.advertisementservice.getadv | 阻断明确命名的广告服务接口；不宣称覆盖开屏 | risk=high | device=unverified
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv(?:\/|\?|$) - reject-dict

[MITM]
hostname = %APPEND% acs.m.taobao.com
