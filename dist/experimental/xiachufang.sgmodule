# WARNING: 本模块需要 HTTPS 解密，默认不得启用。
# 仅在阅读风险说明并准备完成真机回归后安装。

[URL Rewrite]
# xiachufang.ad.api | 阻断独立广告 API 路径 | risk=medium | device=unverified
^https?:\/\/api\.xiachufang\.com\/v\d+\/ad\/ - reject-dict

[MITM]
hostname = %APPEND% api.xiachufang.com
