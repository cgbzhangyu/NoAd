#!name=NoAd - 淘宝 (App-specific / MITM Required)
#!desc=仅处理目标 App 的精确 HTTPS 广告接口；通用广告请直接引用上游规则集
#!author=cgbzhangyu
#!homepage=https://github.com/cgbzhangyu/NoAd
#!category=广告拦截
#!system=ios
#!rule-count=1

# WARNING: 本模块需要 HTTPS 解密和系统信任 Shadowrocket CA。
# 仅解密下方 [MITM] 中列出的目标 App 主机。

[URL Rewrite]
# taobao.advertisementservice.getadv | 阻断明确命名的广告服务接口；不宣称覆盖开屏 | risk=high | device=unverified
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv(?:\/|\?|$) - reject-dict

[MITM]
hostname = %APPEND% acs.m.taobao.com
