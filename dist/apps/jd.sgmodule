#!name=NoAd - 京东 (App-specific / MITM Required)
#!desc=仅处理目标 App 的精确 HTTPS 广告接口；通用广告请直接引用上游规则集
#!author=cgbzhangyu
#!homepage=https://github.com/cgbzhangyu/NoAd
#!category=广告拦截
#!system=ios
#!rule-count=2

# WARNING: 本模块需要 HTTPS 解密和系统信任 Shadowrocket CA。
# 仅解密下方 [MITM] 中列出的目标 App 主机。

[URL Rewrite]
# jd.launch.client-action | 阻断公开来源记录的开屏配置接口 | risk=high | device=unverified
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:home_launchConfig|start)(?:&|$) - reject-dict
# jd.adx.hosts | 阻断京东广告交换路径 | risk=medium | device=unverified
^https?:\/\/(?:bdsp-x|dsp-x)\.jd\.com\/adx\/ - reject

[MITM]
hostname = %APPEND% api.m.jd.com,bdsp-x.jd.com,dsp-x.jd.com
