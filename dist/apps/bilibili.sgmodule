#!name=NoAd - 哔哩哔哩 (App-specific / MITM Required)
#!desc=仅处理目标 App 的精确 HTTPS 广告接口；通用广告请直接引用上游规则集
#!author=cgbzhangyu
#!homepage=https://github.com/cgbzhangyu/NoAd
#!category=广告拦截
#!system=ios
#!rule-count=1

# WARNING: 本模块需要 HTTPS 解密和系统信任 Shadowrocket CA。
# 仅解密下方 [MITM] 中列出的目标 App 主机。

[Script]
# bilibili.splash.v2 | 清空 v2 开屏广告列表与客户端缓存保留列表 | risk=medium | device=passed
NoAd_BiliBili_开屏广告清理 = type=http-response,requires-body=1,max-size=1048576,pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/(?:show|list)(?:\?|$),script-path=https://raw.githubusercontent.com/cgbzhangyu/NoAd/refs/heads/main/runtime/bilibili-splash.js

[MITM]
hostname = %APPEND% app.bilibili.com
