#!name=NoAd - 下厨房 (App-specific / MITM Required)
#!desc=仅处理目标 App 的精确 HTTPS 广告接口；通用广告请直接引用上游规则集
#!author=cgbzhangyu
#!homepage=https://github.com/cgbzhangyu/NoAd
#!category=广告拦截
#!system=ios
#!rule-count=1

# WARNING: 本模块需要 HTTPS 解密和系统信任 Shadowrocket CA。
# 仅解密下方 [MITM] 中列出的目标 App 主机。

[URL Rewrite]
# xiachufang.ad.api | 阻断独立广告 API 路径 | risk=medium | device=unverified
^https?:\/\/api\.xiachufang\.com\/v\d+\/ad\/ - reject-dict

[MITM]
hostname = %APPEND% api.xiachufang.com
