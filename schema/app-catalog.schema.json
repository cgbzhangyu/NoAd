{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cgbzhangyu/NoAd/main/schema/app-catalog.schema.json",
  "title": "NoAd app rule catalog",
  "type": "object",
  "required": ["schema_version", "app", "rules"],
  "properties": {
    "schema_version": { "const": 1 },
    "app": {
      "type": "object",
      "required": ["id", "name", "critical_flows"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "critical_flows": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "tier", "section", "match", "action", "purpose", "risk",
          "source_status", "device_status", "evidence"
        ]
      }
    }
  },
  "additionalProperties": false
}

